#!/usr/bin/env bash
# Reinstall pgsmith (pg_tle) in the compose app database and re-sync Flagsmith.
set -euo pipefail
cd "$(dirname "$0")/.."
python3 extension/build.py >/dev/null
APPDB=${APPDB:-postgresql://postgres:pgfs@127.0.0.1:55433/postgres}
.venv/bin/python - "$APPDB" <<'PY'
import sys, psycopg
with psycopg.connect(sys.argv[1], autocommit=True) as c:
    for name in ("pgsmith", "pg_flagsmith"):   # pg_flagsmith: the project's earlier name
        c.execute(f'DROP EXTENSION IF EXISTS "{name}" CASCADE')
        if c.execute("SELECT count(*) FROM pgtle.available_extensions() WHERE name = %s", (name,)).fetchone()[0]:
            c.execute("SELECT pgtle.uninstall_extension(%s)", (name,))
PY
.venv/bin/pgsmith install --tle --dsn "$APPDB"
set -a; . demos/.env; set +a
.venv/bin/pgsmith sync --dsn "$APPDB" --api "$FLAGSMITH_API_URL" --server-key "$PROD_SERVER_KEY" --server-key "$STAGING_SERVER_KEY" 2>&1 | grep -v INFO
