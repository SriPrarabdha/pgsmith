#!/usr/bin/env bash
# Rebuild pgsmith and reinstall it in the dev container.
set -euo pipefail
# run docker directly when allowed, else through the docker group (sg)
dock() { if docker info >/dev/null 2>&1; then bash -c "$*"; else sg docker -c "$*"; fi; }
cd "$(dirname "$0")/.."
python3 extension/build.py >/dev/null
C=${PGSMITH_CONTAINER:-pgsmith-dev}
V=$(dock "docker exec $C pg_config --sharedir")
dock "docker cp extension/dist/pgsmith--$(cat extension/VERSION).sql $C:$V/extension/ && docker cp extension/dist/pgsmith.control $C:$V/extension/"
scripts/psql -qc "SET client_min_messages = warning; DROP EXTENSION IF EXISTS pgsmith CASCADE; CREATE EXTENSION pgsmith;" 2>&1 | grep -v -E "NOTICE|cascades|DETAIL|other objects" || true
